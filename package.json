{
	"name": "executive-agent",
	"version": "0.0.0",
	"private": true,
	"description": "AI Executive Agent — a personal Chief of Staff for founders and executives. Memory-first, voice-native, predictive, privacy-first.",
	"engines": {
		"node": ">=22.0.0 <23",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "turbo run test",
		"eval": "turbo run eval",
		"eval:unit": "turbo run eval:unit",
		"eval:integration": "turbo run eval:integration",
		"eval:regression": "turbo run eval:regression",
		"gate": "pnpm typecheck && pnpm lint && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@types/node": "^25.6.0",
		"turbo": "^2.5.0",
		"typescript": "^5.6.3",
		"vitest": "^4.1.5"
	}
}
