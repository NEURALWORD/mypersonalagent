{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"eval": {
			"cache": false,
			"outputs": ["eval/runs/**"]
		},
		"eval:unit": {
			"outputs": ["eval/runs/**"]
		},
		"eval:integration": {
			"outputs": ["eval/runs/**"]
		},
		"eval:regression": {
			"cache": false,
			"outputs": ["eval/runs/**"]
		},
		"gate": {
			"dependsOn": ["typecheck", "lint", "test"],
			"outputs": []
		}
	}
}
