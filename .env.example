# See spec/env-vars.md for full descriptions

# === Core ===
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Executive Agent"

# === Database ===
DATABASE_URL=postgresql://dev:dev@localhost:5432/exec_agent_dev
DIRECT_DATABASE_URL=postgresql://dev:dev@localhost:5432/exec_agent_dev

# === Auth (Clerk) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
CLERK_WEBHOOK_SECRET=whsec_REPLACE

# === LLM providers ===
ANTHROPIC_API_KEY=sk-ant-REPLACE
OPENAI_API_KEY=sk-REPLACE

# === Background jobs (Inngest) ===
INNGEST_EVENT_KEY=REPLACE
INNGEST_SIGNING_KEY=signkey-REPLACE

# === Cache & queue (Upstash Redis) ===
UPSTASH_REDIS_REST_URL=https://REPLACE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE

# === Realtime ===
LIVEBLOCKS_SECRET_KEY=sk_REPLACE
LIVEKIT_API_KEY=REPLACE
LIVEKIT_API_SECRET=REPLACE
LIVEKIT_URL=wss://REPLACE.livekit.cloud

# === Voice ===
CARTESIA_API_KEY=REPLACE
DEEPGRAM_API_KEY=REPLACE
ELEVENLABS_API_KEY=REPLACE

# === Storage (Cloudflare R2) ===
R2_ACCOUNT_ID=REPLACE
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET=exec-agent-dev
R2_PUBLIC_URL=https://REPLACE.r2.dev

# === Observability ===
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE
LANGFUSE_SECRET_KEY=sk-lf-REPLACE
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=https://REPLACE@sentry.io/REPLACE
SENTRY_AUTH_TOKEN=REPLACE
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# === Payments ===
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE

# === Integrations OAuth ===
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
MICROSOFT_CLIENT_ID=REPLACE
MICROSOFT_CLIENT_SECRET=REPLACE
SLACK_CLIENT_ID=REPLACE
SLACK_CLIENT_SECRET=REPLACE
SLACK_SIGNING_SECRET=REPLACE

# === Encryption ===
# 32 bytes hex (generate via: openssl rand -hex 32)
DB_COLUMN_ENCRYPTION_KEY=REPLACE_64_HEX_CHARS
# Ed25519 private key for A2A agent identity (base64)
A2A_SIGNING_PRIVATE_KEY=REPLACE

# === Cost guardrails ===
DEFAULT_USER_DAILY_BUDGET_CENTS=300
DEFAULT_USER_MONTHLY_BUDGET_CENTS=8000
HARD_LIMIT_MULTIPLIER=1.2

# === Feature flags ===
FEATURE_VOICE_ENABLED=true
FEATURE_A2A_ENABLED=false
FEATURE_WISDOM_ENABLED=false
FEATURE_AUTOPILOT_EMAIL=false
